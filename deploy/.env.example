# ===== 复制为 .env 后填写；权限务必 chmod 600 =====
# 生成强口令：openssl rand -base64 24
# 生成 JWT 密钥：openssl rand -base64 48

# ---- 数据库（compose 用这些创建库与应用账号，应用也用同一账号连接）----
MYSQL_ROOT_PASSWORD=
DB_USERNAME=club_app
DB_PASSWORD=

# ---- 应用密钥 ----
JWT_SECRET=
# 同域名部署留空（仅同源可调 API，推荐）；跨域部署才填 https://你的域名
CORS_ORIGINS=

# ---- Redis ----
REDIS_PASSWORD=

# ---- AI 助手（可选；不填则 AI 助手不可用，其余功能不受影响）----
DEEPSEEK_API_KEY=
